import cv2
import sys
from pathlib import Path
import matplotlib.pyplot as plt

# Setup de Path para APOO
BASE_DIR = Path(__file__).resolve().parent.parent
if str(BASE_DIR) not in sys.path:
    sys.path.append(str(BASE_DIR))

from src.preprocessor import ImageProcessor

def run_box_test():
    
    image_path = BASE_DIR / "data" / "raw" / "teste.jpg"
    proc = ImageProcessor
    
    # 1. Obter imagem binária
    # (Supondo que seu método get_processed_pipeline retorne original e binária)
    original, binary = proc.get_processed_pipeline(image_path)
    
    # 2. Obter as Bounding Boxes
    boxes = proc.get_bounding_boxes(binary)
    
    # 3. Desenhar na imagem original para conferência
    # Convertemos para RGB apenas para o retângulo ser colorido (Verde)
    output_img = cv2.cvtColor(original, cv2.COLOR_GRAY2RGB)
    
    for (x, y, w, h) in boxes:
        # Desenha o retângulo: (imagem, pt1, pt2, cor, espessura)
        cv2.rectangle(output_img, (x, y), (x + w, y + h), (0, 255, 0), 2)

    plt.figure(figsize=(10, 5))
    plt.imshow(output_img)
    plt.title(f"Detectados {len(boxes)} símbolos")
    plt.axis('off')
    plt.show()

if __name__ == "__main__":
    run_box_test()